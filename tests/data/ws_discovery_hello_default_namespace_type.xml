    xmlns:s12="http://www.w3.org/2003/05/soap-envelope"
    xmlns:wsa="http://www.w3.org/2005/08/addressing"
    xmlns:wsd="http://docs.oasis-open.org/ws-dd/ns/discovery/2009/01">
  <s12:Header>
    <wsa:To>urn:docs-oasis-open-org:ws-dd:ns:discovery:2009:01</wsa:To>
    <wsa:Action>http://docs.oasis-open.org/ws-dd/ns/discovery/2009/01/Hello</wsa:Action>
    <wsa:MessageID>urn:uuid:0a7ba5b3-1f9d-4f2a-9a0e-1f1c2ba4d9cf</wsa:MessageID>
    <wsd:AppSequence InstanceId="1077004800" SequenceId="urn:uuid:369a7d7b-5f87-48a4-aa9a-189edf2a8772"
                     MessageNumber="1"/>
  </s12:Header>
  <s12:Body>
    <wsd:Hello>
      <wsa:EndpointReference>
        <wsa:Address>urn:uuid:98190dc2-0890-4ef8-ac9a-5940995e6119</wsa:Address>
      </wsa:EndpointReference>
      <wsd:Types xmlns="http://docs.oasis-open.org/ws-dd/ns/dpws/2009/01">Device</wsd:Types>
      <wsd:MetadataVersion>2</wsd:MetadataVersion>
    </wsd:Hello>
  </s12:Body>
</s12:Envelope>
