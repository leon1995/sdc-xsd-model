<?xml version="1.0" encoding="utf-8"?>
<!--
  A wse:Unsubscribe. The body element is empty: everything that identifies the subscription is in the header,
  which is why the class has no properties at all and the interesting assertion is that an empty body element
  still deserializes to the typed class rather than to a plain _Element.
-->
<s12:Envelope
    xmlns:s12="http://www.w3.org/2003/05/soap-envelope"
    xmlns:wsa="http://www.w3.org/2005/08/addressing"
    xmlns:wse="http://schemas.xmlsoap.org/ws/2004/08/eventing">
  <s12:Header>
    <wsa:To>https://192.168.0.11:6464/StateEventService</wsa:To>
    <wsa:Action>http://schemas.xmlsoap.org/ws/2004/08/eventing/Unsubscribe</wsa:Action>
    <wsa:MessageID>urn:uuid:1a2b3c4d-0005-4000-8000-000000000005</wsa:MessageID>
    <wse:Identifier>urn:uuid:1a2b3c4d-5555-4000-8000-00000000dead</wse:Identifier>
  </s12:Header>
  <s12:Body>
    <wse:Unsubscribe/>
  </s12:Body>
</s12:Envelope>
